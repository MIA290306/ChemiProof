# Raw third-party data: never commit (see CLAUDE.md invariant 10, data/README.md)
data/raw/
*.dat
*.zip
*.spc
# Everything under data/ is ignored except the policy README and labeled synthetic fixtures
data/*
!data/README.md
!data/fixtures/

# Python / environments
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Secrets / local config
.env
.env.*

# macOS / editors
.DS_Store
.idea/
.vscode/

# Large generated artifacts: only small reviewed CSV/JSON get force-added (see results/README.md)
results/*
!results/README.md
!results/M0_foundation/
!results/M0_foundation/validation_report.md
!results/M1_*/
results/M1_*/*.png
!results/M2_*/
results/M2_*/*.png
!results/M3_*/
results/M3_*/*.png
!results/M4_*/
results/M4_*/*.png
!results/experiment_registry.csv

# Power BI (M6.5): binary reports embed data; exports are derived from the dataset
*.pbix
*.pbit
**/.pbi/localSettings.json
**/.pbi/cache.abf
exports/bi/
